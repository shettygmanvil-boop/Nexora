# ======================================================
# Maproom — Environment Variables
# ======================================================
# Copy this to .env and fill in your actual values.
# NEVER commit real keys to version control.

# --- Application ---
APP_ENV=development
APP_NAME=Maproom
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# --- FastAPI Server ---
HOST=0.0.0.0
PORT=8000

# --- OpenAI (LLM backbone for CrewAI agents) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- OpenWeatherMap API ---
# Sign up at https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# --- AQICN / Air Quality API ---
# Sign up at https://aqicn.org/api/
AQICN_API_KEY=your-aqicn-api-key-here
AQICN_BASE_URL=https://api.waqi.info

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/maproom

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=1800

# --- Logging ---
LOG_LEVEL=INFO
