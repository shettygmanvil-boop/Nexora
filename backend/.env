# Maproom Backend Configuration

# Server settings
HOST=127.0.0.1
PORT=8000

# LLM provider configuration
# Choose: openai, gemini, or mock (runs agent simulations locally without external API keys)
LLM_PROVIDER=mock

# API Keys (Provide your keys to enable real CrewAI agent runs)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# LLM Model Name to use
# Examples: gpt-4o, gemini/gemini-1.5-flash
LLM_MODEL_NAME=gemini/gemini-1.5-flash
